# Copy to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory"

# Auth.js v5
AUTH_SECRET="replace-with-32+-char-random-string"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# TMDB (The Movie Database) — https://developer.themoviedb.org/
# Optional. When absent, movie posters are skipped and a gradient fallback is shown instead.
# Use the Read Access Token (Bearer token), not the API key (v3).
TMDB_API_KEY="eyJ..."

# NODE_ENV is set automatically by Next.js (development / production / test)
