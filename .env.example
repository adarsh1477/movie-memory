# Copy to .env.local and fill in real values.
# Never commit .env.local — it's in .gitignore.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory"

# Auth.js v5
AUTH_SECRET="replace-with-32+-char-random-string"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional. Chat model for fun facts; defaults to gpt-4.1-mini when unset or blank.
# Must be a non-reasoning chat model (the request sends max_tokens and temperature),
# e.g. gpt-4.1-mini, gpt-4.1, gpt-4o-mini. Facts about recent films come from TMDB data,
# not from the model's own knowledge.
OPENAI_MODEL="gpt-4.1-mini"

# Optional. Films released on or after this date (YYYY-MM-DD) get facts built only from TMDB
# data; earlier films use the model's own knowledge. Default 2024-01-01 — set it a few months
# BEFORE OPENAI_MODEL's training cutoff, since recent films are where the model gets trivia wrong.
# Update it when you change OPENAI_MODEL.
MODEL_KNOWLEDGE_CUTOFF="2024-01-01"

# TMDB (The Movie Database) — https://developer.themoviedb.org/
# Optional. When absent, movie posters are skipped and a gradient fallback is shown instead.
# Use the Read Access Token (Bearer token), not the API key (v3).
TMDB_API_KEY="eyJ..."

# NODE_ENV is set automatically by Next.js (development / production / test)
