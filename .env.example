# Copy to BOTH .env (read by the Prisma CLI) and .env.local (read by Next.js), then fill in
# real values. Placeholders only here. Never commit .env or .env.local (both are git-ignored).

# Postgres (matches docker-compose.yml defaults; port 5433 in both .env and .env.local)
DATABASE_URL="postgresql://movie:movie@localhost:5433/movie_memory"

# Auth.js v5
AUTH_SECRET="replace-with-32+-char-random-string"

# Google OAuth: https://console.cloud.google.com/ (Credentials, OAuth client ID, Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OpenAI (server-side only): https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional. Chat model for fun facts; defaults to gpt-4.1-mini when unset or blank.
# Must be a non-reasoning chat model (the request sends max_tokens and temperature),
# e.g. gpt-4.1-mini, gpt-4.1, gpt-4o-mini.
OPENAI_MODEL="gpt-4.1-mini"

# Optional, YYYY-MM-DD, default 2024-01-01. Only used when a film has no Wikipedia notes:
# films released before it fall back to the model's own knowledge, later ones are grounded on
# TMDB data only. Set it a few months BEFORE OPENAI_MODEL's training cutoff, and update it when
# you change OPENAI_MODEL.
MODEL_KNOWLEDGE_CUTOFF="2024-01-01"

# TMDB (The Movie Database): https://developer.themoviedb.org/
# Optional. When absent: search accepts free text, posters are skipped (gradient fallback),
# and facts use the model's own knowledge since there are no TMDB details to ground on.
# Use the Read Access Token (Bearer token), not the API key (v3).
TMDB_API_KEY="your-tmdb-read-access-token"

# Wikipedia needs no key (public MediaWiki API).

# NODE_ENV is set automatically by Next.js (development / production / test)
